# Production settings for compose.yaml. Copy to .env and fill in. Never commit .env.
#
# Passwords and keys don't go here: they're files in PC_SECRETS_DIR, created by
# `make secrets` (see secrets/README.md).

# Public domain of this instance. Choose it carefully: it becomes part of every
# actor URI and can't change once federation is enabled (ADR 0012).
PC_INSTANCE_DOMAIN=pets.example.org

# Display name shown in the apps.
PC_INSTANCE_NAME=Example Pet Community

# Folder holding the secret files (default ./secrets). Keep an offline copy of its
# backup_key and secret_key: backups can't be restored without backup_key, and
# secret_key isn't in the backups (ADR 0012, ADR 0016).
PC_SECRETS_DIR=./secrets

# Database backups (ADR 0016). PC_BACKUP_DIR can be a folder on the server's own disk;
# that protects against mistakes and bad data, but not against losing the disk or the
# server, so copy it elsewhere too (a separate disk, or another machine).
PC_BACKUP_DIR=/var/backups/petcommunity

# Outgoing email, through a transactional email provider's SMTP server (for example
# Postmark, Mailgun, Amazon SES, or Brevo). Set up the provider's domain authentication
# (SPF, DKIM, DMARC) for the PC_MAIL_FROM domain, or mail will land in spam.
PC_SMTP_HOST=smtp.example.com
# 587 with starttls (the usual), or 465 with tls.
PC_SMTP_PORT=587
PC_SMTP_SECURITY=starttls
PC_SMTP_USERNAME=
# The password goes in the smtp_password secret file.
PC_MAIL_FROM=Example Pet Community <noreply@pets.example.org>

# Media storage: an S3-compatible provider (for example Backblaze B2 or Cloudflare R2).
# Create two buckets: a private one for raw uploads (set a lifecycle rule to delete
# objects after 1 day) and a public one for processed images (turn on versioning or
# soft delete, ADR 0010). Use credentials limited to these two buckets, and put them
# in the s3_access_key and s3_secret_key secret files.
PC_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
PC_S3_REGION=us-west-004
PC_S3_QUARANTINE_BUCKET=example-pets-quarantine
PC_S3_MEDIA_BUCKET=example-pets-media
# The public address of the media bucket's contents (the provider's public bucket URL
# or a custom domain), without a trailing slash.
PC_MEDIA_URL=https://media.pets.example.org

# Where users can get the source of the version you run (AGPL section 13).
# Change this if you run a modified version.
PC_SOURCE_URL=https://github.com/chmbrb/PetCommunityProject
