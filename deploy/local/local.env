# Settings for the local production stack (make local-up). Not secret, and never used
# for a real instance: the database is local and all email goes to Mailpit.
PC_INSTANCE_DOMAIN=localhost
PC_INSTANCE_NAME=Local Pet Community
PC_DB_PASSWORD=local-only-password
PC_VERSION=local
# Fixed and public: fine for this throwaway local stack only.
PC_SECRET_KEY=bG9jYWwtb25seSBzZWNyZXQga2V5LCBub3QgcmVhbCE=

PC_SMTP_HOST=mailpit
PC_SMTP_PORT=1025
PC_SMTP_SECURITY=starttls
PC_MAIL_FROM=Local Pet Community <noreply@localhost>

# MinIO in the local stack, standing in for a hosted provider. Images are served
# through Caddy at /media/.
PC_S3_ENDPOINT=http://minio:9000
PC_S3_ACCESS_KEY=local
PC_S3_SECRET_KEY=local-only-storage-password
PC_MEDIA_URL=https://localhost:8443/media
