<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12 and later. The secure storage plugin's values are
  encrypted with a Keystore key that's never backed up, so a restored copy couldn't be
  decrypted: leave them out (ADR 0023). backup_rules.xml covers older versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
